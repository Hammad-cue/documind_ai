# Copy to .env and fill in. Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (pgvector/pgvector:pg16 container)
DB_NAME=docuvault_db
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_HOST=localhost
DB_PORT=5433

# LLM gateway: any OpenAI-compatible endpoint (groq | gemini | openai | ollama)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
VISION_PROVIDER=gemini
VISION_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local models
EMBEDDING_MODEL=all-MiniLM-L6-v2
CLAUSE_MODEL_DIR=ml/models/clause-classifier

# OCR
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Tesseract mean confidence (0-100) below which a page is treated as handwriting
HANDWRITING_CONFIDENCE_THRESHOLD=70
